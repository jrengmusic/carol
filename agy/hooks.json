{
  "carol-protocol-gates": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/agy-gate.mjs",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|send_message|ask_question|invoke_subagent|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/agy-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_file|ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/agy-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/agy-gate.mjs",
        "timeout": 10
      }
    ]
  }
}
