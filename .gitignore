# CAROL Framework - Git Ignore
AGENTS.md
.carol/
carol/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Backup files
*.bak
*.bak[0-9]
*~

# Test artifacts
/tmp/
.tmp/
*.test

# Don't ignore templates (they should be tracked)
!/templates/

# Provider secrets contain API tokens — never tracked
providers/secrets.md

# Generated provider settings carry the token overlay — never tracked
providers/generated/

# Claude Code writes this editor config into a plugin dir loaded with --plugin-dir
/tsconfig.json


.carol-role
