# CAROL Framework - Git Ignore
AGENTS.md
.carol/
carol/
# The OpenCode plugin has the same folder name as the project state folder
!/opencode/plugins/carol/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Backup files
*.bak
*.bak[0-9]
*~

# Test artifacts
/tmp/
.tmp/
*.test

# Don't ignore templates (they should be tracked)
!/templates/

# Provider secrets contain API tokens — never tracked
providers/secrets.md

# Generated provider settings carry the token overlay — never tracked
providers/generated/

# Local model weights — machine-local, never tracked
/local/models/

# Claude Code writes this editor config into a plugin dir loaded with --plugin-dir
/tsconfig.json


.carol-role

# Secrets
ant.k
.teleoperator/
