#!/bin/bash
# carol - CAROL Framework CLI Tool
# Version is SSOT'd in /VERSION — read at runtime below.

# Resolve CAROL_ROOT handling symlinks (e.g. if /usr/local/bin/carol -> ~/.carol/bin/carol)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
CAROL_ROOT="$( cd -P "$( dirname "$SOURCE" )/.." >/dev/null 2>&1 && pwd )"

VERSION="$(cat "$CAROL_ROOT/VERSION" 2>/dev/null | tr -d '[:space:]')"
[ -z "$VERSION" ] && VERSION="unknown"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
GREY='\033[0;37m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Logo banner with gradient (cyan → magenta)
ansi_art_lines=(
    "\033[38;2;0;212;255m    ████████     ████     ██████████     ████████   ████        \033[0m"
    "\033[38;2;51;170;255m  ████░░░░░░   ████████   ████░░░░████ ████░░░░████ ████        \033[0m"
    "\033[38;2;102;128;255m████░░       ████░░░░████ ████    ████ ████    ████ ████        \033[0m"
    "\033[38;2;153;102;255m████         ████    ████ ██████████░░ ████    ████ ████        \033[0m"
    "\033[38;2;178;76;230m████         ████████████ ████░░████   ████    ████ ████        \033[0m"
    "\033[38;2;204;51;204m░░████       ████░░░░████ ████  ░░████ ████    ████ ████        \033[0m"
    "\033[38;2;230;25;179m  ░░████████ ████    ████ ████    ████ ░░████████░░ ████████████\033[0m"
    "\033[38;2;255;0;153m    ░░░░░░░░ ░░░░    ░░░░ ░░░░    ░░░░   ░░░░░░░░   ░░░░░░░░░░░░\033[0m"
)

show_banner() {
    echo ""
    for line in "${ansi_art_lines[@]}"; do
        echo -e "$line"
    done
    echo ""
    echo -e "${CYAN}Cognitive Amplifier Role Orchestration for LLM agents${NC}"
}

# Helper functions
error() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

success() {
    echo -e "${GREEN}✓ $1${NC}"
}

info() {
    echo -e "${YELLOW}→ $1${NC}"
}

notice() {
    echo -e "${BLUE}ℹ $1${NC}"
}

warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

get_remote_version() {
    local version=""
    version=$(curl -fsSL https://raw.githubusercontent.com/jrengmusic/carol/main/bin/carol 2>/dev/null | grep '^VERSION=' | head -1 | cut -d'"' -f2)
    echo "$version"
}

version_greater_than() {
    [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" != "$1" ]
}

format_thousands() {
    awk -v n="$1" 'BEGIN{
        sign=""; if (n<0){sign="-"; n=-n}
        s=sprintf("%d", n); len=length(s); result=""; count=0
        for (i=len; i>=1; i--) {
            result = substr(s,i,1) result; count++
            if (count%3==0 && i!=1) result = "," result
        }
        print sign result
    }'
}


CAROL_PERMISSIONS='{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git checkout --*)",
      "Bash(git branch -D*)"
    ]
  },
  "showTurnDuration": false
}'

CAROL_CLAUDE_SETTINGS='{
  "statusLine": {
    "type": "command",
    "command": "~/.carol/bin/carol-statusline.sh"
  }
}'

setup_statusline() {
    local settings=".claude/settings.json"
    mkdir -p .claude

    if [ ! -f "$settings" ]; then
        echo "$CAROL_CLAUDE_SETTINGS" > "$settings"
        success "Statusline configured"
        return 0
    fi

    if ! command -v jq &>/dev/null; then
        warning "Install jq to auto-configure statusLine, or merge manually from $CAROL_ROOT/.claude-plugin/plugin.json"
        return 0
    fi

    local tmp
    tmp=$(jq --argjson carol "$CAROL_CLAUDE_SETTINGS" '. * $carol' "$settings")
    echo "$tmp" > "$settings"
    success "Statusline configured"
}

setup_global_statusline() {
    # MACHINIST runs without project scaffold, so statusLine must live in
    # user-global settings. Idempotent — skips if already present.
    local settings="$HOME/.claude/settings.json"
    mkdir -p "$HOME/.claude"

    if [ ! -f "$settings" ]; then
        echo "$CAROL_CLAUDE_SETTINGS" > "$settings"
        return 0
    fi

    if grep -q '"statusLine"' "$settings"; then
        return 0
    fi

    if ! command -v jq &>/dev/null; then
        warning "Install jq to auto-configure global statusLine"
        return 0
    fi

    local tmp
    tmp=$(jq --argjson carol "$CAROL_CLAUDE_SETTINGS" '. * $carol' "$settings")
    echo "$tmp" > "$settings"
}

CAROL_MARKETPLACE_NAME="carol-marketplace"
CAROL_PLUGIN_ID="carol@${CAROL_MARKETPLACE_NAME}"

ensure_marketplace_added() {
    if claude plugin marketplace list 2>/dev/null | grep -q "$CAROL_MARKETPLACE_NAME"; then
        return 0
    fi
    info "Adding $CAROL_MARKETPLACE_NAME..."
    claude plugin marketplace add "$CAROL_ROOT" 2>&1 || warning "Could not add marketplace. Retry manually: claude plugin marketplace add $CAROL_ROOT"
}

refresh_marketplace() {
    ensure_marketplace_added
    claude plugin marketplace update "$CAROL_MARKETPLACE_NAME" 2>&1 >/dev/null || true
}

symlink_carol_assets() {
    # Symlink reference docs into carol/ so ARCHITECT can @mention them
    # SSOT: edits to ~/.carol/*.md reflect instantly, no copies.
    local ref_doc
    for ref_doc in NAMES.md MANIFESTO.md SPEC-WRITER.md ARCHITECTURE-WRITER.md JRENG-CODING-STANDARD.md LANGUAGE.md ODE.md ARCHITECT.md; do
        [ -f "$CAROL_ROOT/$ref_doc" ] && ln -sf "$CAROL_ROOT/$ref_doc" "carol/$ref_doc"
    done

    # Symlink agents and slash commands into project-level .claude/ so they use
    # bare names (/go, @oracle) instead of plugin-namespaced (/carol:go, @carol:oracle).
    mkdir -p .claude/agents .claude/commands

    # MACHINIST is a top-level primary, not a subagent. Remove any stale symlink
    # so `carol update` cleans up existing projects that were init'd under older
    # versions. Launched only via `carol machinist` → _launch_machinist.
    rm -f ".claude/agents/machinist.md"

    local agent_file cmd_file
    if [ -d "$CAROL_ROOT/agents" ]; then
        for agent_file in "$CAROL_ROOT/agents"/*.md; do
            [ "$(basename "$agent_file")" = "machinist.md" ] && continue
            [ -f "$agent_file" ] && ln -sf "$agent_file" ".claude/agents/$(basename "$agent_file")"
        done
    fi
    if [ -d "$CAROL_ROOT/commands" ]; then
        for cmd_file in "$CAROL_ROOT/commands"/*.md; do
            [ -f "$cmd_file" ] && ln -sf "$cmd_file" ".claude/commands/$(basename "$cmd_file")"
        done
    fi
}

setup_global_permissions() {
    local settings="$HOME/.claude/settings.json"
    mkdir -p "$HOME/.claude"

    if [ ! -f "$settings" ]; then
        echo "$CAROL_PERMISSIONS" > "$settings"
        success "Global Claude Code permissions configured"
        return 0
    fi

    if grep -q '"permissions"' "$settings"; then
        notice "Global permissions already set — skipping"
        return 0
    fi

    if command -v jq &>/dev/null; then
        local tmp
        tmp=$(jq --argjson perms "$CAROL_PERMISSIONS" '. + $perms' "$settings")
        echo "$tmp" > "$settings"
        success "Global Claude Code permissions merged into settings.json"
    else
        warning "~/.claude/settings.json exists but has no permissions block"
        warning "Install jq or add permissions manually"
    fi
}

customize_templates() {
    local project_path="$1"
    local project_name=$(basename "$project_path")
    local date=$(date +"%Y-%m-%d")

    if [ -f "carol/SPRINT-LOG.md" ]; then
        if [[ "$OSTYPE" == "darwin"* ]]; then
            sed -i '' "s/\[Project Name\]/$project_name/g" carol/SPRINT-LOG.md
            sed -i '' "s/\[YYYY-MM-DD\]/$date/g" carol/SPRINT-LOG.md
            sed -i '' "s|\[repo-url or local path\]|$project_path|g" carol/SPRINT-LOG.md
        else
            sed -i "s/\[Project Name\]/$project_name/g" carol/SPRINT-LOG.md
            sed -i "s/\[YYYY-MM-DD\]/$date/g" carol/SPRINT-LOG.md
            sed -i "s|\[repo-url or local path\]|$project_path|g" carol/SPRINT-LOG.md
        fi
    fi

    if [ -f "carol/config.yml" ]; then
        if [[ "$OSTYPE" == "darwin"* ]]; then
            sed -i '' "s/\[PROJECT_NAME\]/$project_name/g" carol/config.yml
            sed -i '' "s|\[PROJECT_PATH\]|$project_path|g" carol/config.yml
            sed -i '' "s/\[DATE\]/$date/g" carol/config.yml
        else
            sed -i "s/\[PROJECT_NAME\]/$project_name/g" carol/config.yml
            sed -i "s|\[PROJECT_PATH\]|$project_path|g" carol/config.yml
            sed -i "s/\[DATE\]/$date/g" carol/config.yml
        fi
    fi
}

synth_claude_md() {
    local project_path="$1"
    local claude_md="$project_path/CLAUDE.md"
    local synth_mode="new"

    # Symlink → remove and treat as new
    if [ -L "$claude_md" ]; then
        rm -f "$claude_md"
        synth_mode="replace"
    elif [ -f "$claude_md" ]; then
        # Full CAROL.md copy starts with "# CAROL"
        if head -1 "$claude_md" | grep -q "^# CAROL"; then
            synth_mode="replace"
        else
            synth_mode="update"
        fi
    fi

    local instruction
    if [ "$synth_mode" = "update" ]; then
        instruction="MACHINIST synthesis — update check. Read CLAUDE.md, carol/SPRINT-LOG.md, and DEBT.md. If sprint state or active debt has drifted from what CLAUDE.md contains, update CLAUDE.md in place. If already current, do nothing."
    else
        instruction="MACHINIST synthesis — write. Read: CMakeLists.txt, ARCHITECTURE.md, SPEC.md, carol/SPRINT-LOG.md, DEBT.md (all if present). Write a thin project CLAUDE.md per MACHINIST synthesis protocol: project identity (name, type, stack, root, version), current state (last sprint, active ODE if present, active debt), layer order and key source dirs, key docs table, doxygen locations (project + active libs only — exclude unused frameworks), build note."
    fi

    info "Synthesizing CLAUDE.md ($synth_mode)..."
    if claude -p \
        --dangerously-skip-permissions \
        --append-system-prompt-file "$CAROL_ROOT/CAROL.md" \
        "$instruction"; then
        success "CLAUDE.md synthesized"
    else
        echo -e "${RED}✗ CLAUDE.md synthesis failed — check claude availability${NC}" >&2
    fi
}

cmd_init() {
    local project_path="."

    while [ $# -gt 0 ]; do
        case "$1" in
            --symlink|--portable)
                notice "Note: $1 is deprecated in v0.0.9+ — CAROL is now a Claude Code plugin"
                shift
                ;;
            -*)
                error "Unknown flag: $1"
                ;;
            *)
                if [ "$project_path" = "." ]; then
                    project_path="$1"
                fi
                shift
                ;;
        esac
    done

    cd "$project_path" || error "Cannot access directory: $project_path"
    project_path="$(pwd)"

    # Inside CAROL repo itself — skip init, just launch
    if [ "$project_path" = "$CAROL_ROOT" ]; then
        show_banner
        echo -e "${GREY}✓ v${VERSION} This is HOME${NC}"
        echo ""
        return 0
    fi

    if [ -d "carol" ] || [ -d ".carol" ]; then
        echo -e "${MAGENTA}${BOLD}ℹ CAROL already initiated.${NC}"
        echo ""
        echo "  carol reset   Remove and start fresh"
        echo "  carol update  Update framework"
        echo ""
        exit 0
    fi

    # Create minimal carol/ dir for project state (SPRINT-LOG + config)
    mkdir -p carol
    if [[ "$OSTYPE" == "darwin"* ]]; then
        chflags hidden carol
    elif [[ "$OSTYPE" == "msys" ]] || [[ "$OSTYPE" == "cygwin" ]] || [[ "$OSTYPE" == "win32" ]]; then
        attrib +h carol 2>/dev/null
    fi

    # Restore SPRINT-LOG from backup or use template
    if [ -f ".carol-history/SPRINT-LOG.md" ]; then
        cp ".carol-history/SPRINT-LOG.md" carol/SPRINT-LOG.md
        rm -rf .carol-history
        notice "SPRINT-LOG.md restored from backup"
    elif [ -f "$CAROL_ROOT/templates/SPRINT-LOG.md" ]; then
        cp "$CAROL_ROOT/templates/SPRINT-LOG.md" carol/SPRINT-LOG.md
    fi

    # Copy config.yml template
    if [ -f "$CAROL_ROOT/templates/config.yml" ]; then
        cp "$CAROL_ROOT/templates/config.yml" carol/config.yml
    fi

    symlink_carol_assets

    customize_templates "$project_path"

    setup_global_permissions
    ensure_marketplace_added
    setup_statusline

    synth_claude_md "$project_path"

    show_banner
    echo -e "${GREY}✓ v${VERSION} System initiated (plugin mode).${NC}"
    echo ""
    echo "Rock 'n Roll!"
}

cmd_update() {
    show_banner

    # NO git operations here — local edits to ~/.carol are honored.
    # ARCHITECT manages git state manually.

    # Refresh marketplace catalog (picks up local edits to ~/.carol)
    info "Refreshing marketplace..."
    refresh_marketplace

    # If inside a CAROL project, re-symlink assets (picks up new agents/commands/docs)
    if [ -d "carol" ] || [ -d ".carol" ]; then
        info "Refreshing symlinks..."
        symlink_carol_assets
        setup_statusline
        synth_claude_md "$(pwd)"
    fi

    success "Update complete (v$VERSION)"
}

cmd_install() {
    local claude_config="$HOME/.config/claude"
    local global_claude_md="$claude_config/CLAUDE.md"
    local harness_claude_md="$HOME/.claude/CLAUDE.md"

    show_banner

    if [ ! -f "$CAROL_ROOT/ARCHITECT.md" ]; then
        error "~/.carol/ARCHITECT.md not found — create the ARCHITECT profile first"
    fi

    mkdir -p "$claude_config"
    printf '@~/.carol/CAROL.md\n@~/.carol/ARCHITECT.md\n' > "$global_claude_md"
    success "Global CLAUDE.md loader written (~/.config/claude/CLAUDE.md)"

    mkdir -p "$HOME/.claude"
    rm -f "$harness_claude_md"
    ln -s "$global_claude_md" "$harness_claude_md"
    success "~/.claude/CLAUDE.md → ~/.config/claude/CLAUDE.md"

    success "Install complete"
}

cmd_version() {
    show_banner
    echo -e "${GREY}✓ v${VERSION}${NC}"
    echo ""
    
    local remote_version=$(get_remote_version)
    if [ -n "$remote_version" ] && version_greater_than "$remote_version" "$VERSION"; then
        notice "Update available: v$VERSION → v$remote_version"
        echo "  Run 'carol update' to upgrade"
        echo ""
    fi
}

cmd_reset() {
    if [ ! -d "carol" ] && [ ! -d ".carol" ]; then
        notice "No CAROL workflow found in current directory"
        return 0
    fi

    echo ""
    echo -e "${CYAN}${BOLD}⚠ This will remove CAROL from:${NC}"
    echo "  $(pwd)"
    echo ""
    echo -en "${MAGENTA}Are you sure? [y/N]${NC} "
    read -r response

    if [[ "$response" =~ ^[Yy]$ ]]; then
        # Preserve SPRINT-LOG.md if it exists
        local sprint_log=""
        if [ -f "carol/SPRINT-LOG.md" ]; then
            sprint_log=$(cat "carol/SPRINT-LOG.md")
        elif [ -f ".carol/SPRINT-LOG.md" ]; then
            sprint_log=$(cat ".carol/SPRINT-LOG.md")
        fi

        rm -rf carol .carol
        rm -rf .claude
        rm -f CLAUDE.md

        # Restore SPRINT-LOG.md for next init
        if [ -n "$sprint_log" ]; then
            mkdir -p .carol-history
            echo "$sprint_log" > .carol-history/SPRINT-LOG.md
            notice "SPRINT-LOG.md preserved in .carol-history/"
        fi

        echo -e "${YELLOW}✓ No CAROL, no cigar${NC}"
    else
        info "Cancelled"
    fi
}

cmd_help() {
    show_banner
    echo ""
    echo -e "${CYAN}Usage:${NC}"
    echo "  carol <command> [options]"
    echo ""
    echo -e "${MAGENTA}Commands:${NC}"
    echo -e "  ${YELLOW}install${NC}        Set up global CLAUDE.md loader and ~/.claude symlink (run once per machine)"
    echo -e "  ${YELLOW}init${NC}           Initialize CAROL in current project (plugin mode)"
    echo -e "  ${YELLOW}oracle${NC} [name]       Launch ORACLE session (research, RFC, analysis)"
    echo -e "  ${YELLOW}counselor${NC} [name]  Launch COUNSELOR session (default model)"
    echo -e "  ${YELLOW}machinist${NC} [name]  Launch MACHINIST session (machine custodian, no project scaffold)"
    echo -e "  ${YELLOW}debt${NC} <subcmd>  Manage DEBT.md ledger (add/clear)"
    echo -e "  ${YELLOW}ledger${NC}         Show DEBT.md ledger"
    echo -e "  ${YELLOW}loc${NC} [days]      Show git line-change stats for last N days (default 7)"
    echo -e "  ${YELLOW}continue${NC}       Resume last CAROL session"
    echo -e "  ${YELLOW}sessions${NC}       List sessions for current project"
    echo -e "  ${YELLOW}resume <id>${NC}    Resume session by short ID or name"
    echo -e "  ${YELLOW}reset${NC}          Remove CAROL from current project"
    echo -e "  ${YELLOW}update${NC}         Update CAROL framework"
    echo -e "  ${YELLOW}version${NC}        Show CAROL version"
    echo -e "  ${YELLOW}help${NC}           Show this help message"
    echo ""
    echo -e "${MAGENTA}PRIMARY Agents:${NC}"
    echo -e "  ${CYAN}ORACLE${NC}        Research, ideation, RFC production, deep analysis"
    echo -e "  ${CYAN}COUNSELOR${NC}     Planning, specs, docs, bug fixing, implementation, SPRINT-LOG"
    echo -e "  ${CYAN}MACHINIST${NC}     Machine custodian — CAROL, harness, ~/.config, dotfiles, dev env"
    echo ""
    echo -e "${MAGENTA}Secondary Agents:${NC}"
    echo -e "  ${CYAN}Engineer${NC}      Code implementation (BLESSED-compliant, flags pre-existing violations)"
    echo -e "  ${CYAN}Librarian${NC}     Library/framework research"
    echo -e "  ${CYAN}Auditor${NC}       QA/QC validation"
    echo -e "  ${CYAN}Pathfinder${NC}    Pattern discovery (ALWAYS first)"
    echo -e "  ${CYAN}Researcher${NC}    Domain research"
    echo ""
    echo -e "${MAGENTA}Slash Commands:${NC}"
    echo -e "  ${YELLOW}/counselor${NC}   Activate COUNSELOR (default on init)"
    echo -e "  ${YELLOW}/pay${NC}         Drain DEBT.md ledger into next sprint plan (COUNSELOR only)"
    echo -e "  ${YELLOW}/log${NC}         Log sprint, drain paid debts (COUNSELOR)"
    echo -e "  ${YELLOW}/stop${NC}        Emergency brake — cease all execution"
    echo -e "  ${YELLOW}/ode${NC}         ODE to Joy — reframe the problem"
    echo ""
    echo -e "  ${MAGENTA}carol${NC} = CAROL plugin enforced. ${MAGENTA}claude${NC} = raw, no CAROL protocol."
    echo -e "  bare ${YELLOW}carol${NC} auto-selects role: COUNSELOR in a project, MACHINIST elsewhere."
    echo ""
    echo -e "${GREY}https://github.com/jrengmusic/carol${NC}"
    echo ""
}


get_project_hash() {
    local cwd
    if command -v cygpath &>/dev/null; then
        cwd=$(cygpath -w "$(pwd)")
    else
        cwd=$(pwd)
    fi
    echo "$cwd" | sed 's/[^a-zA-Z0-9]/-/g'
}

cmd_sessions() {
    local project_hash
    project_hash=$(get_project_hash)
    local sessions_dir="$HOME/.claude/projects/$project_hash"

    if [ ! -d "$sessions_dir" ]; then
        notice "No sessions found for this project"
        return 0
    fi

    local jsonl_files
    jsonl_files=$(ls -t "$sessions_dir"/*.jsonl 2>/dev/null)

    if [ -z "$jsonl_files" ]; then
        notice "No sessions found"
        return 0
    fi

    echo ""
    echo -e "${CYAN}Sessions — $(pwd)${NC}"
    echo ""
    printf "${BOLD}%-10s %-14s %-34s %s${NC}\n" "ID" "ROLE" "NAME" "DATE"
    echo "────────────────────────────────────────────────────────────────────────"

    while IFS= read -r file; do
        local uuid
        uuid=$(basename "$file" .jsonl)
        local short_id="${uuid:0:8}"
        local date
        date=$(date -r "$file" "+%d-%m-%Y" 2>/dev/null)

        local python_file="$file"
        command -v cygpath &>/dev/null && python_file=$(cygpath -w "$file")
        local output role label
        output=$(python3 -c "
import json
role = ''
label = ''
try:
    with open(r'$python_file', encoding='utf-8') as f:
        lines = f.readlines()
    # Extract agent role
    for line in lines:
        try:
            d = json.loads(line)
            if d.get('type') == 'agent-setting':
                role = d.get('agentSetting', '')
                break
        except: continue
    # Prefer custom-title (set by /rename)
    for line in reversed(lines):
        try:
            d = json.loads(line)
            if d.get('type') == 'custom-title':
                label = d.get('customTitle', '')
                break
        except: continue
    # Fall back to first real user message
    if not label:
        for line in lines:
            try:
                d = json.loads(line)
                if d.get('type') == 'user':
                    content = d.get('message', {}).get('content', '')
                    text = content if isinstance(content, str) else next((b.get('text','') for b in content if isinstance(b,dict) and b.get('text')), '')
                    text = text.strip()
                    if text and not text.startswith('<'):
                        label = ' '.join(text.split())[:50]
                        break
            except: continue
except: pass
print(role)
print(label)
" 2>/dev/null)
        role=$(printf '%s' "$output" | head -1)
        label=$(printf '%s' "$output" | sed -n '2p')

        [ -z "$role" ] && role="-"
        [ -z "$label" ] && label="(no label)"
        local role_color
        case "$role" in
            ORACLE)       role_color='\033[38;2;217;119;41m'  ;;
            COUNSELOR)    role_color='\033[38;2;0;200;216m'   ;;
                MACHINIST)    role_color='\033[38;2;160;160;160m' ;;
            *)            role_color="$GREY"                  ;;
        esac
        local f_id f_role f_name
        f_id=$(printf "%-10s" "$short_id")
        f_role=$(printf "%-14s" "$role")
        f_name=$(printf "%-34s" "${label:0:34}")
        printf "${YELLOW}%s${NC} ${role_color}%s${NC} %s ${GREY}%s${NC}\n" "$f_id" "$f_role" "$f_name" "$date"
    done <<< "$jsonl_files"

    echo ""
}

cmd_resume() {
    local id="$1"
    [ -z "$id" ] && error "Usage: carol resume <session-id>"

    local project_hash
    project_hash=$(get_project_hash)
    local sessions_dir="$HOME/.claude/projects/$project_hash"

    local full_uuid=""

    # Resolve by short ID prefix
    if [ -d "$sessions_dir" ]; then
        full_uuid=$(ls "$sessions_dir"/*.jsonl 2>/dev/null | xargs -I{} basename {} .jsonl | grep "^$id" | head -1)
    fi

    # Use as-is (full UUID or whatever was passed)
    [ -z "$full_uuid" ] && full_uuid="$id"

    local model_flag=()
    local meta_file="$sessions_dir/$full_uuid.meta"
    local session_file="$sessions_dir/$full_uuid.jsonl"
    if [ -f "$meta_file" ]; then
        local meta_model
        meta_model=$(grep '^model=' "$meta_file" | head -1 | sed 's/^model=//')
        if [ -n "$meta_model" ]; then
            model_flag=(--model "$meta_model")
        fi
    elif [ -f "$session_file" ]; then
        local python_file="$session_file"
        command -v cygpath &>/dev/null && python_file=$(cygpath -w "$session_file")
        local model
        model=$(python3 -c "
import json
model = ''
try:
    with open(r'$python_file', encoding='utf-8') as f:
        for line in reversed(f.readlines()):
            try:
                d = json.loads(line)
                if d.get('type') == 'assistant':
                    m = (d.get('message') or {}).get('model', '')
                    if m:
                        model = m
                        break
            except: continue
except: pass
print(model)
" 2>/dev/null)
        [ -n "$model" ] && model_flag=(--model "$model")
    fi

    exec claude --resume "$full_uuid" "${model_flag[@]}"
}

cmd_continue() {
    cmd_run --continue
}

cmd_debt() {
    local subcmd="${1:-help}"
    [ $# -gt 0 ] && shift

    case "$subcmd" in
        add)
            cmd_debt_add "$@"
            ;;
        clear)
            cmd_debt_clear "$@"
            ;;
        help|--help|-h)
            cmd_debt_help
            ;;
        *)
            error "Unknown debt subcommand: $subcmd. Run 'carol debt help' for usage."
            ;;
    esac
}

cmd_debt_help() {
    echo ""
    echo -e "${CYAN}Usage:${NC} carol debt <subcommand>"
    echo ""
    echo -e "${MAGENTA}Subcommands:${NC}"
    echo -e "  ${YELLOW}add${NC}              Interactive prompt to register a new debt entry"
    echo -e "  ${YELLOW}clear <id>${NC}       Drain a paid debt entry by ID (called by /log hygiene)"
    echo ""
    echo -e "${GREY}DEBT.md is the inter-sprint ledger at project root. JRENG = paid in full.${NC}"
    echo ""
}

cmd_debt_add() {
    # Lazy create DEBT.md from template if missing
    if [ ! -f "DEBT.md" ]; then
        if [ -f "$CAROL_ROOT/templates/DEBT.md" ]; then
            cp "$CAROL_ROOT/templates/DEBT.md" DEBT.md
            notice "Created DEBT.md from template"
        else
            error "DEBT.md template not found at $CAROL_ROOT/templates/DEBT.md"
        fi
    fi

    # Generate ID from UTC timestamp
    local id="DEBT-$(date -u +%Y%m%dT%H%M%S)"

    echo ""
    echo -e "${CYAN}New debt entry — ${BOLD}$id${NC}"
    echo -e "${GREY}Empty answer or Ctrl-C aborts. No partial entry will be saved.${NC}"
    echo ""

    local observation divergence expectation

    echo -e "${YELLOW}What did you see?${NC}"
    read -r -e observation
    if [ -z "$observation" ]; then
        info "Cancelled — no entry registered"
        return 0
    fi

    echo -e "${YELLOW}What went wrong?${NC}"
    read -r -e divergence
    if [ -z "$divergence" ]; then
        info "Cancelled — no entry registered"
        return 0
    fi

    echo -e "${YELLOW}What did you expect?${NC}"
    read -r -e expectation
    if [ -z "$expectation" ]; then
        info "Cancelled — no entry registered"
        return 0
    fi

    # Find line number of first --- separator (end of preamble)
    local sep_line
    sep_line=$(grep -n '^---$' DEBT.md | head -1 | cut -d: -f1)
    if [ -z "$sep_line" ]; then
        error "DEBT.md format invalid: no '---' separator found"
    fi

    # Build new file: preamble through first ---, then new entry, then rest
    local tmp_file="DEBT.md.tmp.$$"
    {
        sed -n "1,${sep_line}p" DEBT.md
        echo ""
        echo "## $id"
        echo ""
        echo "**Observation:** $observation"
        echo "**Divergence:** $divergence"
        echo "**Expectation:** $expectation"
        echo ""
        echo "---"
        sed -n "$((sep_line+1)),\$p" DEBT.md
    } > "$tmp_file"
    mv "$tmp_file" DEBT.md

    success "Debt registered: $id"
}

cmd_ledger() {
    if [ ! -f "DEBT.md" ]; then
        notice "No DEBT.md in this project — ledger is empty"
        return 0
    fi

    local past_preamble=0
    while IFS= read -r line; do
        if [ "$past_preamble" -eq 0 ]; then
            if [ "$line" = "---" ]; then
                past_preamble=1
            fi
        elif [[ "$line" =~ ^##\ (DEBT-[0-9T]+)$ ]]; then
            echo -e "\033[1;36m${line}${NC}"
        elif [[ "$line" =~ ^\*\*Observation:\*\*(.*)$ ]]; then
            echo -e "${YELLOW}**Observation:**${BASH_REMATCH[1]}${NC}"
        elif [[ "$line" =~ ^\*\*Divergence:\*\*(.*)$ ]]; then
            echo -e "${RED}**Divergence:**${BASH_REMATCH[1]}${NC}"
        elif [[ "$line" =~ ^\*\*Expectation:\*\*(.*)$ ]]; then
            echo -e "${GREEN}**Expectation:**${BASH_REMATCH[1]}${NC}"
        elif [ "$line" = "---" ]; then
            echo -e "${GREY}---${NC}"
        else
            echo "$line"
        fi
    done < DEBT.md
}

cmd_loc() {
    local days="${1:-7}"
    [[ "$days" =~ ^[0-9]+$ ]] || error "Invalid day count: $days. Usage: carol loc [days]"
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || error "Not inside a git repository"

    local added=0 deleted=0
    while IFS=$'\t' read -r a d _; do
        [[ "$a" =~ ^[0-9]+$ ]] && added=$((added + a))
        [[ "$d" =~ ^[0-9]+$ ]] && deleted=$((deleted + d))
    done < <(git log --since="${days} days ago" --numstat --pretty=tformat:)

    local net=$((added - deleted)) net_sign="+" net_abs=$((added - deleted))
    [ "$net" -lt 0 ] && net_sign="-" && net_abs=$((-net))

    echo ""
    echo -e "${CYAN}Last ${days} day(s):${NC}"
    echo -e "  - ${GREEN}+$(format_thousands "$added") additions${NC}"
    echo -e "  - ${RED}−$(format_thousands "$deleted") deletions${NC}"
    echo -e "  - Net: ${net_sign}$(format_thousands "$net_abs") lines"
    echo ""
}

cmd_debt_clear() {
    local id="$1"
    [ -z "$id" ] && error "Usage: carol debt clear <DEBT-id>"
    [ ! -f "DEBT.md" ] && error "No DEBT.md in current directory"

    # Find the heading line for the target id
    local start_line
    start_line=$(grep -n "^## $id$" DEBT.md | head -1 | cut -d: -f1)
    [ -z "$start_line" ] && error "$id not found in DEBT.md"

    # Find the next --- separator after start_line — this is the entry's terminator
    local end_line
    end_line=$(awk -v start="$start_line" 'NR > start && /^---$/ { print NR; exit }' DEBT.md)
    [ -z "$end_line" ] && error "$id has no terminating separator (DEBT.md corrupt?)"

    # Delete from start_line to end_line (inclusive)
    local tmp_file="DEBT.md.tmp.$$"
    sed "${start_line},${end_line}d" DEBT.md > "$tmp_file"
    mv "$tmp_file" DEBT.md

    success "Drained $id"
}

symlink_machinist_assets() {
    # MACHINIST + its team resolve as user-global agents so `carol machinist`
    # works anywhere (no project scaffold required). Lazy-created on launch.
    # Engineer deliberately excluded — MACHINIST executes directly.
    mkdir -p "$HOME/.claude/agents"
    local agent_file
    for agent_file in machinist.md pathfinder.md oracle.md librarian.md researcher.md; do
        [ -f "$CAROL_ROOT/agents/$agent_file" ] && \
            ln -sf "$CAROL_ROOT/agents/$agent_file" "$HOME/.claude/agents/$agent_file"
    done
}

_launch_machinist() {
    local claude_args=("$@")
    symlink_machinist_assets
    setup_global_statusline
    show_banner
    echo -e "${GREY}✓ v${VERSION} MACHINIST mode — machine custodian${NC}"
    echo ""

    export CAROL_ROLE=MACHINIST
    exec claude \
        --plugin-dir "$CAROL_ROOT" \
        --add-dir "$CAROL_ROOT" \
        --append-system-prompt-file "$CAROL_ROOT/CAROL.md" \
        "${claude_args[@]}"
}

cmd_run() {
    local claude_args=()
    local session_name=""
    local requested_role=""
    local is_resume=false

    # Separate claude flags from session name
    while [ $# -gt 0 ]; do
        case "$1" in
            --agent)
                requested_role="$2"
                claude_args+=("$1" "$2")
                shift 2
                ;;
            --continue|-c|continue)
                is_resume=true
                # Normalize word form to flag form so claude sees --continue
                if [ "$1" = "continue" ]; then
                    claude_args+=("--continue")
                else
                    claude_args+=("$1")
                fi
                shift
                ;;
            --model)
                claude_args+=("$1" "$2")
                shift 2
                ;;
            --*)
                claude_args+=("$1")
                shift
                ;;
            *)
                session_name="$1"
                shift
                ;;
        esac
    done

    # Context detection
    local in_project=false
    if [ -d "carol" ] || [ -d ".carol" ]; then
        in_project=true
    fi
    local cwd
    cwd=$(pwd)
    local inside_carol_root=false
    if [ "$cwd" = "$CAROL_ROOT" ]; then
        inside_carol_root=true
    fi

    # MACHINIST: no project scaffold. Registered as user-global agent by
    # _launch_machinist via ~/.claude/agents/ symlinks. Handled BEFORE the
    # resume branch because MACHINIST sessions never need project context.
    if [ "$requested_role" = "MACHINIST" ]; then
        if [ -n "$session_name" ]; then
            claude_args+=("/rename $session_name")
        fi
        _launch_machinist "${claude_args[@]}"
    fi

    # Resume mode: prior session has its own role — skip role forcing.
    # BUT still ensure project scaffold exists before resuming.
    if $is_resume; then
        if ! $in_project && ! $inside_carol_root; then
            info "No CAROL project here — initializing before resume..."
            cmd_init
        else
            show_banner
        fi
        export CAROL_ROLE="${requested_role:-COUNSELOR}"
        exec claude "${claude_args[@]}"
    fi

    # Bare carol = COUNSELOR, always. cwd is always a project.
    # MACHINIST only via explicit `carol machinist` or --agent MACHINIST.
    if [ -z "$requested_role" ]; then
        requested_role="COUNSELOR"
        claude_args+=(--agent COUNSELOR)
    fi
    export CAROL_ROLE="$requested_role"

    # Project roles (ORACLE, COUNSELOR): need project context
    if ! $in_project; then
        info "No CAROL project here — initializing..."
        cmd_init
    else
        show_banner
    fi

    local agent_model=""
    local agent_file="$HOME/.claude/agents/$(echo "$requested_role" | tr '[:upper:]' '[:lower:]').md"
    if [ -f "$agent_file" ]; then
        agent_model=$(grep '^model:' "$agent_file" | head -1 | sed 's/^model:[[:space:]]*//')
    fi

    if [ -n "$agent_model" ]; then
        local ts_file
        ts_file=$(mktemp)
        local launch_sessions_dir="$HOME/.claude/projects/$(get_project_hash)"
        if [ -n "$session_name" ]; then
            MSYS_NO_PATHCONV=1 claude "${claude_args[@]}" "/rename $session_name"
        else
            claude "${claude_args[@]}"
        fi
        local new_session
        new_session=$(find "$launch_sessions_dir" -name "*.jsonl" -newer "$ts_file" 2>/dev/null | sort | tail -1)
        if [ -n "$new_session" ]; then
            local base_uuid
            base_uuid=$(basename "$new_session" .jsonl)
            printf 'agent=%s\nmodel=%s\n' "$requested_role" "$agent_model" > "$launch_sessions_dir/$base_uuid.meta"
        fi
        rm -f "$ts_file"
    else
        if [ -n "$session_name" ]; then
            MSYS_NO_PATHCONV=1 exec claude "${claude_args[@]}" "/rename $session_name"
        else
            exec claude "${claude_args[@]}"
        fi
    fi
}

cmd_provider() {
    local provider="$1"
    local settings_src="$CAROL_ROOT/providers/${provider}.settings.json"
    local settings_dst="$HOME/.config/claude/settings.json"

    if [ ! -f "$settings_src" ]; then
        printf 'carol: no settings file for provider "%s" at %s\n' "$provider" "$settings_src" >&2
        exit 1
    fi

    ln -sf "$settings_src" "$settings_dst"
    printf 'provider: %s — restart Claude Code to activate\n' "$provider"
}

# Main command dispatcher
case "${1:-run}" in
    init)
        shift
        cmd_init "$@"
        ;;
    install)
        cmd_install
        ;;
    reset)
        cmd_reset
        ;;
    update)
        cmd_update
        ;;
    version)
        cmd_version
        ;;
    help|--help|-h)
        cmd_help
        ;;
    run)
        shift
        cmd_run "$@"
        ;;
    continue|--continue|-c)
        cmd_continue
        ;;
    oracle)
        shift
        cmd_run --agent ORACLE "$@"
        ;;
    counselor|counsel)
        shift
        cmd_run --agent COUNSELOR "$@"
        ;;
    machinist|machine)
        shift
        cmd_run --agent MACHINIST "$@"
        ;;
    debt)
        shift
        cmd_debt "$@"
        ;;
    ledger)
        cmd_ledger
        ;;
    loc)
        shift
        cmd_loc "$@"
        ;;
    sessions|list)
        cmd_sessions
        ;;
    resume)
        shift
        cmd_resume "$@"
        ;;
    minimax)
        cmd_provider "minimax"
        ;;
    anthropic)
        cmd_provider "anthropic"
        ;;
    *)
        cmd_run "$@"
        ;;
esac
